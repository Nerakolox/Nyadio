{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "node --env-file=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prisma": "node --env-file=../../.env node_modules/prisma/build/index.js",
    "seed:config": "tsx --env-file=../../.env src/scripts/seed-config.ts",
    "seed:admin": "tsx --env-file=../../.env src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.8.2",
    "dotenv": "^17.4.2",
    "execa": "^9.5.3",
    "fastify": "^5.3.3",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
