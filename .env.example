# ============================================================
# Nyadio — 环境变量示例
# 复制为 .env 并填入实际值
# ============================================================

# PostgreSQL 连接串（必填）
# 格式：postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/nyadio

# JWT 签名密钥（必填），建议用以下命令生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-byte-secret

# HLS 段文件存储目录（可选）
# Linux 默认 /dev/shm/nyadio（tmpfs，无需修改）
# Windows 示例：C:/Temp/nyadio
HLS_DIR=/dev/shm/nyadio

# Fastify 监听端口（可选，默认 3000）
PORT=3000

# Fastify 监听地址（可选，默认 0.0.0.0）
HOST=0.0.0.0

# 环境标识（可选，默认 production）
NODE_ENV=production

# pino 日志级别（可选，默认 info）
# 可选值：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ffmpeg 可执行文件路径（可选）
# 留空时使用 PATH 中的 ffmpeg；Windows 本地可指向 tools/ffmpeg/ffmpeg.exe
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
